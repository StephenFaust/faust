# -------------------------------------------------------
# Faust Agent Center - 环境变量样例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略
# -------------------------------------------------------

# 服务
SERVER_PORT=8080
#SPRING_PROFILES_ACTIVE=local

# MySQL
# 注意：连接串含 & 符号，必须用单引号包裹，否则 shell source 时会解析失败
MYSQL_URL='jdbc:mysql://localhost:3306/faust?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowMultiQueries=true'
MYSQL_USERNAME=root
# 与 docker-compose.yml 中 MySQL 的 root 密码保持一致
MYSQL_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 对象存储（S3 协议兼容：MinIO / OSS / COS）
S3_BUCKET=community-service-exporter
S3_ACCESS_KEY=EC1D9ABSPKC39QOWFZHS
S3_SECRET_KEY=4sb1710eic36KfHCAjSi8Loo7vatjIzuMuwM8ofI
S3_ENDPOINT= http://test-storage.lianjia.com
S3_PUBLIC_ENDPOINT=http://test-storage.lianjia.com
S3_SIGNING_REGION=cn-north-1
S3_PRESIGN_EXPIRE_MINUTES=1440

# 数据源密码加解密密钥（AES-256 派生）
# 生产环境务必替换为随机值，例如：openssl rand -base64 32
AGENT_PASSWORD_SECRET=please-change-me-in-production

# Druid 监控台
DRUID_USERNAME=druid
DRUID_PASSWORD=druid
